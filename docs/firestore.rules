// ==============================================================================
// FIRESTORE SECURITY RULES KARANGKITA (versi baru: Sekretaris, Bendahara, Iuran, Usulan)
// Tempel manual di Firebase Console > Firestore Database > Rules, lalu klik Publish.
// PERINGATAN: File ini hanya dokumentasi lokal. Jangan jalankan firebase deploy CLI.
// ==============================================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuth() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isPengurusRole(r) {
      return r in ['Pengurus', 'Ketua', 'Sekretaris', 'Bendahara', 'Admin'];
    }

    function isApprovedAdmin() {
      return isAuth() &&
        isPengurusRole(getUserData().role) &&
        getUserData().disetujui == true;
    }

    function isKetuaOrAdmin() {
      return isAuth() &&
        (getUserData().role == 'Ketua' || getUserData().role == 'Admin') &&
        getUserData().disetujui == true;
    }

    function isSekretaris() {
      return isAuth() &&
        getUserData().role == 'Sekretaris' &&
        getUserData().disetujui == true;
    }

    function isBendaharaAtauKetua() {
      return isAuth() &&
        (getUserData().role == 'Bendahara' || getUserData().role == 'Ketua' || getUserData().role == 'Admin') &&
        getUserData().disetujui == true;
    }

    // 1. KOLEKSI 'users'
    match /users/{userId} {
      // Baca: Pemilik dokumen sendiri OR Admin/Pengurus disetujui
      allow read: if isAuth() && (request.auth.uid == userId || isApprovedAdmin());

      // Buat Dokumen Baru (CREATE):
      // A. Registrasi Mandiri: Peran 'Pengurus' wajib disetujui == false
      // B. Tambah Anggota Baru oleh Admin: Hanya untuk peran 'Anggota'
      allow create: if isAuth() && (
        (
          request.auth.uid == userId &&
          (request.resource.data.role == 'Pengurus' || request.resource.data.role == 'Anggota') &&
          (request.resource.data.role != 'Pengurus' || request.resource.data.disetujui == false)
        )
        ||
        (
          isApprovedAdmin() &&
          request.resource.data.role == 'Anggota'
        )
      );

      // Edit Profil (UPDATE):
      // A. User biasa mengedit nama/kontak sendiri: DILARANG merubah 'role' atau 'disetujui'
      allow update: if isAuth() && request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'disetujui']);

      // A2. Serah terima: Ketua boleh menurunkan dirinya sendiri menjadi Pengurus
      allow update: if isKetuaOrAdmin() && request.auth.uid == userId &&
        resource.data.role == 'Ketua' &&
        request.resource.data.role == 'Pengurus' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']);

      // B. Pengurus Disetujui mengedit Anggota: HANYA BOLEH merubah 'nama' & 'whatsapp'
      allow update: if isApprovedAdmin() && request.auth.uid != userId &&
        resource.data.role == 'Anggota' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nama', 'whatsapp']);

      // C. Ketua / Admin Utama: Boleh mengubah SELURUH field milik orang lain
      allow update: if isKetuaOrAdmin() && request.auth.uid != userId;

      // Hapus Akun (DELETE):
      // - DILARANG menghapus akun milik sendiri
      // - Ketua/Admin boleh menghapus akun siapapun (selain dirinya)
      // - Pengurus disetujui HANYA BOLEH menghapus akun ber-peran 'Anggota'
      allow delete: if isAuth() && request.auth.uid != userId && (
        isKetuaOrAdmin() ||
        (isApprovedAdmin() && resource.data.role == 'Anggota')
      );
    }

    // 2. KOLEKSI 'kegiatan' (dibaca publik agar mode tamu tanpa login bisa melihat)
    match /kegiatan/{kegiatanId} {
      allow read: if true;
      allow create, update, delete: if isApprovedAdmin();
    }

    // 3. KOLEKSI 'jadwal' (Sementara selama migrasi)
    match /jadwal/{jadwalId} {
      allow read: if isAuth();
      allow create, update, delete: if isApprovedAdmin();
    }

    // 4. KOLEKSI 'galeri'
    match /galeri/{galeriId} {
      allow read: if isAuth();
      allow create, update, delete: if isApprovedAdmin();
    }

    // 5. KOLEKSI 'usulan' (bottom-up: Anggota mengusulkan, Sekretaris meninjau/meneruskan, Ketua memutuskan)
    match /usulan/{usulanId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.pengusulUid == request.auth.uid;
      allow update: if isAuth() && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dukungan']) ||
        (isSekretaris() && resource.data.status == 'Menunggu' && (request.resource.data.status == 'Diteruskan' || request.resource.data.status == 'Ditolak')) ||
        (isKetuaOrAdmin() && resource.data.status == 'Diteruskan' && (request.resource.data.status == 'Disetujui' || request.resource.data.status == 'Ditolak')) ||
        (resource.data.pengusulUid == request.auth.uid && resource.data.status == 'Menunggu')
      );
      allow delete: if isApprovedAdmin() ||
        (isAuth() && resource.data.pengusulUid == request.auth.uid && resource.data.status == 'Menunggu');
    }

    // 6. KOLEKSI 'notifikasi' (notifikasi dalam aplikasi)
    match /notifikasi/{notifId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dibacaOleh']);
    }

    // 7. KOLEKSI 'iuran' (tagihan iuran oleh Bendahara/Ketua)
    match /iuran/{iuranId} {
      allow read: if isAuth();
      allow create, update, delete: if isBendaharaAtauKetua();
    }

    // 8. KOLEKSI 'pembayaran' (konfirmasi bayar oleh anggota & verifikasi oleh Bendahara/Ketua)
    match /pembayaran/{pembayaranId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.uidAnggota == request.auth.uid;
      allow update: if isBendaharaAtauKetua() || (isAuth() && resource.data.uidAnggota == request.auth.uid);
      allow delete: if isBendaharaAtauKetua();
    }

    // 9. KOLEKSI 'kontak' (salinan minimal data penerima notifikasi email: uid, nama, email, role, disetujui)
    match /kontak/{userId} {
      allow read: if isAuth();
      allow create: if isAuth() && (
        (
          request.auth.uid == userId &&
          (request.resource.data.role == 'Pengurus' || request.resource.data.role == 'Anggota') &&
          (request.resource.data.role != 'Pengurus' || request.resource.data.disetujui == false)
        )
        ||
        isApprovedAdmin()
      );
      allow update: if isKetuaOrAdmin() || (
        isAuth() && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nama', 'email'])
      );
      allow delete: if isKetuaOrAdmin();
    }
  }
}
